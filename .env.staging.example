# ==========================================================
# STAGING ENVIRONMENT CONFIGURATION (FRONTEND)
# ==========================================================
# Saat di-deploy dengan Docker, API diakses melalui reverse-proxy Nginx di path /api
VITE_API_URL=/api

# WhatsApp gateway dikosongkan pada environment staging
VITE_WHATSAPP_API_URL=

# Environment flag (menampilkan badge STAGING di header)
VITE_APP_ENV=staging

# Nama aplikasi
VITE_APP_NAME=ZEA_TEXTILE_STAGING
